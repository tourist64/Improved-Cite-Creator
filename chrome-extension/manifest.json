{
  "manifest_version": 3,
  "name": "Cite Creator",
  "version": "1.1.0",
  "description": "Build accurate debate citations from the page you're reading, with author/date/quals you can review before copying.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extractor.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
